{
  "scripts": {
    "build": "scripts/test.sh --build-only",
    "test": "scripts/test.sh",
    "test:unit": "ts-mocha -p ./tsconfig.json --fail-zero --forbid-only --forbid-pending \"tests/unit/**/*.spec.ts\"",
    "test:integration": "ts-mocha -p ./tsconfig.json -t 60000 --fail-zero --forbid-only --forbid-pending \"tests/integration/**/*.spec.ts\"",
    "test:rust": "cargo test --workspace",
    "test:checks": "yarn lint && yarn typecheck && yarn test:rust && yarn check:architecture && yarn check:idl",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.cjs",
    "check:idl": "node scripts/check-idl.cjs",
    "lint:fix": "prettier \"app/**/*.ts\" \"examples/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.cjs\" --write",
    "lint": "prettier \"app/**/*.ts\" \"examples/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.cjs\" --check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/web3.js": "1.91.9"
  },
  "resolutions": {
    "@solana/web3.js": "1.91.9"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.4.1",
    "mocha": "^9.2.2",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.3.5"
  }
}
